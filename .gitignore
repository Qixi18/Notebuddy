# Frontend dependencies and build output
node_modules/
dist/

# Python caches and virtual environments
__pycache__/
*.py[cod]
.venv/
.venv-*/
# Project-local UV, managed Python, Node, model/download caches and setup logs.
.runtime/
.pytest_cache/
.ruff_cache/

# Local configuration and data
# 密钥只允许留在本地 .env（由设置面板写入），永不提交。
.env
.env.*
!.env.example
data/*
!data/.gitkeep

# 本地数据库 / 备份 / 课件原文的兜底防护
*.sqlite
*.sqlite3
*.db
*.bak
data/backups/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test and log output
*.log
coverage/
.playwright-cli/
.vitest/
output/playwright/
# 临时测试素材（如手工放的样例 PDF / PPTX），不进仓库
test-*.pdf
test-*.pptx

# 本地会话与工作记忆（WorkBuddy 生成，只属于本机，不是项目文件）
.workbuddy/

# Task implementation scratch and review evidence
.superpowers/

# Local browser and visual QA output; no tracked files live here
/apps/web/output/

# Developer-local scripts and draft notes
/scripts/local/
/scripts/scratch/
/scripts/experiments/
/scripts/*.local.py
/scripts/*.local.ps1
/scripts/*.scratch.py
/scripts/*.scratch.ps1
/docs/_drafts/
/docs/_local/
/.scratch/
/.notes/

# Local test and profiling output
/.cache/
/.mypy_cache/
/.coverage
/.coverage.*
/htmlcov/
/playwright-report/
/test-results/
/output/
*.prof
*.pstats
*.cpuprofile
*.heapprofile

# Generated preview; product animation files and manifest stay tracked
/apps/web/public/assets/pet/preview.html

