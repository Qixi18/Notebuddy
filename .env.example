# DeepSeek 文本模型（答疑、正文生成等）
DEEPSEEK_API_KEY=
# 不填模型和地址时，程序默认使用 https://api.deepseek.com / deepseek-chat。

# 视觉模型（你选用的 DeepSeek V4.1 Flash 1017）
NOTEBOOK_VISION_BASE_URL=https://api.deepseek.com
NOTEBOOK_VISION_API_KEY=
NOTEBOOK_VISION_MODEL=deepseek-flash

# 文档付费处理预算：每个文件上限为 10 元。
# 按供应商当前价格填写；留空/为 0 时，未配置对应模型的付费调用会被阻止。
DEEPSEEK_INPUT_COST_PER_MILLION=0
DEEPSEEK_OUTPUT_COST_PER_MILLION=0
DEEPSEEK_PRICE_VERSION=
DEEPSEEK_PRICE_SOURCE=

NOTEBOOK_VISION_INPUT_COST_PER_MILLION=0
NOTEBOOK_VISION_OUTPUT_COST_PER_MILLION=0
NOTEBOOK_VISION_MAX_IMAGE_TOKENS=
NOTEBOOK_VISION_PRICE_VERSION=
NOTEBOOK_VISION_PRICE_SOURCE=

# 汇率快照必须在最近 30 天内；来源填写公开网页地址。
NOTEBOOK_BUDGET_USD_CNY_RATE=
NOTEBOOK_BUDGET_FX_RATE_SOURCE=
NOTEBOOK_BUDGET_FX_RATE_AS_OF=

# 以下外部服务均为可选；需要时取消注释并填写。
# 标准资料处理默认 200 MiB / 2000 页；已有配置优先，图片保持独立大小限制。
# NOTEBOOK_MAX_UPLOAD_MB=200
# NOTEBOOK_MAX_PAGES=2000

# 新上传的 llm 路线默认本地优先、视觉兜底；旧任务保留上传时的快照。
# NOTEBOOK_LLM_READING_MODE=hybrid
# 需要新上传恢复逐页视觉读取时设置 vision。
# MinerU 可用 setup.ps1 -WithMinerU 安装；模型缓存在 .runtime/mineru。

# Tavily 联网搜索
# TAVILY_API_KEY=

# OpenAI 兼容的 Embedding 服务
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
